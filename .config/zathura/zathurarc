set font "monospace normal 16"

# Allow recolor
set recolor 'false'

# Don't allow original hue when recoloring
set recolor-keephue 'true'

# Don't keep original image colors while recoloring
set recolor-reverse-video 'false'

# Command line completion entries
set completion-fg '#654735'
set completion-bg '#f5edca'

# Command line completion group elements
set completion-group-fg '#6c782e'
set completion-group-bg '#f5edca'

# Current command line completion element
set completion-highlight-fg '#f5edca'
set completion-highlight-bg '#654735'

# Default foreground/background color
set default-fg "#654735"
set default-bg '#f5edca'

# Input bar
set inputbar-fg '#654735'
set inputbar-bg '#f5edca'

# Notification
set notification-fg '#654735'
set notification-bg '#f5edca'

# Error notification
set notification-error-fg '#654735'
set notification-error-bg '#f8e4c9'

# Warning notification
set notification-warning-fg '#654735'
set notification-warning-bg '#f8e4c9'

# Status bar
set statusbar-fg '#654735'
set statusbar-bg '#f5edca'

# Highlighting parts of the document (e.g. show search results)
# set highlight-color '#fff176'
# set highlight-active-color '#ffcc80'
# set highlight-fg '#000000'

# Represent light/dark colors in recoloring mode
set recolor-lightcolor rgba(0,0,0,0)
set recolor-darkcolor '#654735'

# 'Loading...' text
set render-loading-fg '#654735'
set render-loading-bg '#f5edca'


set selection-clipboard 'clipboard'
set window-title-basename true
set statusbar-basename true
