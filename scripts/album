#!/bin/bash

################################################################################
### Argument Parsing 
################################################################################
usage="Usage: $0 [-h] [-p] [-s] [-c value] <artist> <album> <url>"
show_help() {
    cat <<EOF
Usage:
    $0 [OPTIONS] <artist> <album> <url>

Description:
    Download and add metadata to music

Positional arguments:
    input       Input file or directory.
    output      Output file or directory.
    logfile     Log file to write messages to.

Options:
    -h          Show this help message and exit.
    -p          Split by playlist. 
    -s          Split by video sections.
    -c IMG_FILE Specify cover image

EOF
    exit "${1:-0}"
}

while getopts "hpsc:" opt; do
	case "$opt" in
		h)
			show_help
			exit 0
			;;
		p)
			OUTPUT_FORMAT=(
				"-o"
				"%(playlist_index)02d %(title)s.%(ext)s"
			)
			SPLIT="true"
			;;
		s)
			OUTPUT_FORMAT=(
				"--split-chapters" 
				"-o"
				"output.%(ext)s"
				"-o"
				"chapter:%(section_number)02d %(section_title)s.%(ext)s"
			)
			SPLIT="true"
			;;
		c)
			COVER="$OPTARG"
			;;
		\?)
			echo $usage
			exit 1
			;;
		:)
			echo "Option -$OPTARG requires an argument."
			echo $usage
			exit 1
			;;
	esac
done
shift $((OPTIND - 1))

if [ "$#" -ne 3 ]; then
	echo "Error: expected 3 positional arguments."
	echo $usage
fi

ARTIST="$1"
ALBUM="$2"
URL="$3"
if (( ${#OUTPUT_FORMAT[@]} == 0 )); then
	OUTPUT_FORMAT=("-o" "$ALBUM.%(ext)s")
fi

################################################################################
### Create file structure
################################################################################
mkdir -p "$ARTIST/$ALBUM"
cd "$ARTIST/$ALBUM"

################################################################################
### Download
################################################################################
yt-dlp -t mp3 \
	--js-runtime "deno:~/.deno/bin/deno"\
	${COVER:-"--write-thumbnail"} \
	"${OUTPUT_FORMAT[@]}" \
	"$URL" 
rm output.mp3

################################################################################
# Process Cover
################################################################################
# if cover is link
if [[ "$COVER" =~ ^https?:// ]]; then
	curl -L "$COVER" -o img
	COVER="img"
fi

magick ${COVER:-"*.webp"} \
    -gravity center \
    -crop "%[fx:min(w,h)]x%[fx:min(w,h)]+0+0" +repage \
    -resize 256x256 \
    cover.jpg
rm *webp img


################################################################################
# If set split
# Add Artist, Album, Cover, Title, and Numbering 
################################################################################
if [[ -n "$SPLIT" ]] ; then 
	for file in *.mp3; do 
		if [[ "$file" =~ ^([0-9]+)[[:space:]]+(.+)\.mp3$ ]]; then
			track="${BASH_REMATCH[1]}"
			title="${BASH_REMATCH[2]}"
			echo "Track=$track, Title=$title"
			id3v2 -a "$ARTIST" \
				-A "$ALBUM" \
				-t "$title" \
				-T "$track" \
				--APIC "image/jpeg:3::cover.jpg" \
				"$file"
			eyeD3 --add-image cover.jpg:FRONT_COVER \
				-a "$ARTIST" \
				-A "$ALBUM" \
				-t "$title" \
				-n "$track" \
				--encoding utf16 \
				--to-v2.3 \
				"$file"
		fi
	done

################################################################################
# Add Only Artist, Album, and Cover 
################################################################################
else
id3v2 -a "$ARTIST" \
	-A "$ALBUM" \
	-t "$ALBUM" \
	--APIC "image/jpeg:3::cover.jpg" \
	*.mp3
eyeD3 --add-image cover.jpg:FRONT_COVER \
	-a "$ARTIST" \
	-A "$ALBUM" \
	-t "$ALBUM" \
	--encoding utf16 \
	--to-v2.3 \
	*.mp3
fi
